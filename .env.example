# Copia este archivo a .env.local y completa los valores.
# En Vercel se configuran por entorno (Production / Preview / Development).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Clave pública (anon o publishable). Puede llegar al navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (service_role o secret). Solo servidor: nunca con prefijo NEXT_PUBLIC_.
# Opcional: solo hace falta en entornos que usen createAdminClient.
SUPABASE_SERVICE_ROLE_KEY=

# URL base de la app para los enlaces de autenticación (npm run dev usa el puerto 3005).
# En previews de Vercel se puede omitir: se usa VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3005
